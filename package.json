{
  "name": "experiment-verdict",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4194 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4194 --strictPort",
    "build": "npm run check:runtime && npm run typecheck && vite build && cp -R docs dist/docs && npm run build:docs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && npm run test:docs",
    "test:e2e": "playwright test",
    "check:runtime": "node scripts/check-runtime.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "test:docs": "node --test scripts/build-docs.test.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
